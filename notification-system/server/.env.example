PORT=8788
FRONTEND_ORIGIN=http://localhost:5173
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=replace_with_public_key
VAPID_PRIVATE_KEY=replace_with_private_key
VAPID_SUBJECT=mailto:admin@example.com
# Long random value; only trusted backend code should know this.
NOTIFICATION_EVENT_SECRET=replace_with_a_long_random_secret

